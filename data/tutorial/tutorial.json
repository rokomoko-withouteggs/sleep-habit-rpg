          "action": "input",
          "nextStepId": "step_sleep_complete"
        },
        {
          "id": "step_sleep_complete",
          "message": "素晴らしい！睡眠スコアに応じて報酬がもらえます。良い睡眠を心がけましょう！",
          "action": "next"
        },
        {
          "id": "step_story_intro",
          "message": "次はストーリーを進めましょう。「ストーリー」ボタンをタップしてください。",
          "targetElement": "#nav-story",
          "action": "click",
          "nextStepId": "step_story_select"
        },
        {
          "id": "step_story_select",
          "message": "第1章「眠りの始まり」をプレイしましょう。ステージを選択してください。",
